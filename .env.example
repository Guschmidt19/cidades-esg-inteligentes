# =============================================================================
#  Variáveis de ambiente do Docker Compose
#  Copie este arquivo para ".env" e ajuste os valores:
#     Linux/macOS/Git Bash:  cp .env.example .env
#     PowerShell:            Copy-Item .env.example .env
#  O arquivo .env NÃO vai para o Git (está no .gitignore).
# =============================================================================

# Ambiente do ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Porta da API no seu computador -> http://localhost:8080/swagger
API_PORT=8080

# Versão exibida em /api/info (no pipeline vira o SHA do commit)
APP_VERSION=local

# Banco PostgreSQL (container "db")
POSTGRES_DB=esg_residuos
POSTGRES_USER=esg
POSTGRES_PASSWORD=troque_esta_senha_local

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=troque-por-uma-chave-secreta-com-32-caracteres-ou-mais

# (Opcional) porta do Adminer -> http://localhost:8081
ADMINER_PORT=8081

# (Opcional) usar uma imagem já publicada em vez de construir localmente
# API_IMAGE=ghcr.io/SEU_USUARIO/cidades-esg-inteligentes:latest
