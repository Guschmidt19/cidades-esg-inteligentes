{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthResponse",
  "type": "object",
  "required": ["status", "ambiente", "versao", "checks"],
  "properties": {
    "status":   { "type": "string", "enum": ["Healthy", "Degraded", "Unhealthy"] },
    "ambiente": { "type": "string", "minLength": 1 },
    "versao":   { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "status", "duracaoMs"],
        "properties": {
          "nome":      { "type": "string" },
          "status":    { "type": "string" },
          "duracaoMs": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}